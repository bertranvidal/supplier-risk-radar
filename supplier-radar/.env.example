# Copy to .env and fill in only what you need. Nothing here is required to run the core pipeline.

# --- Scraping + live dashboard tab (Supabase / Postgres) ---
SUPABASE_URL=
SUPABASE_KEY=
NEWSAPI_KEY=

# --- Notifications for CRITICAL alerts (notify.py) ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Alert drafting with a local LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
ALERT_MODEL=            # any model shown by `ollama list`; auto-picked if empty

# --- Optional ---
RADAR_MODELS=           # folder with another set of trained weights (default: ./models)
RADAR_WORKERS=          # parallel workers for analysis
ANTHROPIC_API_KEY=      # only for distill_claude.py (one-off label distillation)
